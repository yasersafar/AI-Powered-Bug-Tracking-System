# Copy this file to .env and change the values:  cp .env.example .env
# .env is in .gitignore, so your real passwords are never committed.

# Used by the PostgreSQL container (docker-compose.yml)
POSTGRES_USER=bugtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bugtracker

# Used by the backend to connect to the database (#11)
DATABASE_URL=postgresql+psycopg://bugtracker:change-me@localhost:5432/bugtracker
