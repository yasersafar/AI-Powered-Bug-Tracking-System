# Copy this file to .env and change the values:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# PostgreSQL (docker-compose "db" service)
# ---------------------------------------------------------------------------
POSTGRES_USER=bugtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bugtracker
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Host-side URL, used when you run the backend or tests outside Docker.
# Inside Docker, docker-compose.yml overrides the host part with "db".
DATABASE_URL=postgresql+psycopg://bugtracker:change-me@localhost:5432/bugtracker
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# JWT signing key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
# Fixed 8-hour token lifetime (FR-02). Do not change without updating the SRS.
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed CORS origins (VS Code webviews call the API
# from the extension host, so this is only needed for browser-based tools).
CORS_ORIGINS=

# Attachments (FR-14)
ATTACHMENT_DIR=/data/attachments
ATTACHMENT_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# Notifications (FR-16, FR-17)
# ---------------------------------------------------------------------------
# Self-hosted ntfy only. Never point this at the public ntfy.sh server:
# bug text would leave our infrastructure (DC-03).
NTFY_PORT=8080
NTFY_BASE_URL=http://localhost:8080
NTFY_PUBLISH_URL=http://localhost:8080
NTFY_TOPIC_PREFIX=bugtracker
# ntfy denies everything by default. The backend publishes with this token (account
# "bt-publisher", write-only on bugtracker-* topics); anyone may only *read* a topic, and each
# user's topic name is random. Both values are generated by `make env`.
NTFY_PUBLISH_TOKEN=generated-by-make-env
NTFY_PUBLISHER_HASH=generated-by-make-env

# SMTP (Mailpit in development: web UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=Bug Tracker <no-reply@bugtracker.local>
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---------------------------------------------------------------------------
# AI triage (models run inside the backend, on CPU, from local files only)
# ---------------------------------------------------------------------------
# false = start without models: every bug is saved as Unclassified (NFR-10).
# Administrators can also switch AI off at runtime (setting `ai_enabled`).
ML_ENABLED=true
# Threads per inference step (the Docker backend reads ML_ARTIFACTS_DIR from the image).
ML_THREADS=2
# Local runs (uvicorn outside Docker) default to <repo>/ml/artifacts.
# ML_ARTIFACTS_DIR=

# ---------------------------------------------------------------------------
# Demo data (`make seed`)
# ---------------------------------------------------------------------------
# Password of every seeded account. Generated by `make env`.
SEED_PASSWORD=generated-by-make-env
